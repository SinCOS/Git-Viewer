{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "repositoryId",
    "operation"
  ],
  "properties": {
    "repositoryId": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "status",
        "diff",
        "history",
        "branches",
        "worktrees",
        "graph",
        "stage",
        "unstage",
        "stageHunk",
        "unstageHunk",
        "discardHunk",
        "undoCommit",
        "stashPush",
        "stashUntracked",
        "stashPop",
        "discard",
        "commit",
        "amend",
        "switchBranch",
        "createBranch",
        "cherryPick",
        "revert",
        "fetch",
        "fetchPrune",
        "fetchAll",
        "pullFfOnly",
        "pullRebase",
        "pullFrom",
        "push",
        "pushTo",
        "sync"
      ]
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ref": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "patch": {
      "type": "string",
      "maxLength": 1048576
    }
  }
}
