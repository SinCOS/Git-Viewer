{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved location (no credentials)",
  "type": "object",
  "required": ["kind", "path"],
  "properties": {
    "kind": {"enum": ["ssh", "workspace", "ssh-folder", "ssh-workspace"]},
    "host": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"},
    "path": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"enum": ["ssh", "ssh-folder", "ssh-workspace"]}}}, "then": {"required": ["host"]}},
    {"if": {"properties": {"kind": {"const": "workspace"}}}, "then": {"not": {"required": ["host"]}}}
  ],
  "additionalProperties": false
}
