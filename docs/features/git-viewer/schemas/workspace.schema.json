{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VS Code Workspace parsed document",
  "type": "object",
  "required": [
    "folders"
  ],
  "properties": {
    "folders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "settings": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "launch": {
      "type": "object"
    },
    "tasks": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Schema for parsed JSONC document, not raw JSONC source; VS Code may use additional fields."
}
