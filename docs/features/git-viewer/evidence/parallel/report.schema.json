{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["workstream", "baseline", "environment", "commands", "scenarios", "metrics", "limitations"],
  "additionalProperties": false,
  "properties": {
    "workstream": {"enum": ["native-ui", "ssh-runtime"]},
    "baseline": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "environment": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "string"}},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "exitCode"], "additionalProperties": false, "properties": {"command": {"type": "string"}, "exitCode": {"type": "integer"}}}},
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "status", "details"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "status": {"enum": ["passed", "failed", "unverified"]}, "details": {"type": "string"}}}},
    "metrics": {"type": "array", "items": {"type": "object", "required": ["name", "value", "unit"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
